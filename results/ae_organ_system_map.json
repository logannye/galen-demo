{
  "version": "1.0",
  "rationale": "Maps each AE to an organ system relevant for preclinical tox study design (matches in vivo tox panels: cardiac telemetry, hepatic LFT, renal Cr/BUN, hematologic CBC, etc.). Used for per-organ-system view in the demo to organize predictions by clinical workflow.",
  "systems": {
    "cardiac": "Cardiovascular \u2014 telemetry, troponin, BP monitoring",
    "hepatic": "Hepatic \u2014 LFT panel (ALT, AST, ALP, bilirubin)",
    "renal": "Renal \u2014 Cr, BUN, electrolytes",
    "hematologic": "Hematologic \u2014 CBC, differential, coagulation",
    "pulmonary": "Pulmonary \u2014 PFTs, chest imaging",
    "gi": "Gastrointestinal \u2014 endoscopy, stool studies",
    "neuro_psych": "Neurologic / Psychiatric \u2014 neuro exam, cognitive testing",
    "dermatologic": "Dermatologic \u2014 skin exam, photo documentation",
    "endocrine": "Endocrine \u2014 TSH, glucose, cortisol",
    "immune_infection": "Immune / Infectious \u2014 immunoglobulins, cultures, PML monitoring",
    "musculoskeletal": "Musculoskeletal \u2014 CK, joint imaging",
    "ophthalmologic": "Ophthalmologic \u2014 slit lamp, IOP, fundoscopy",
    "reproductive": "Reproductive \u2014 fertility assessment",
    "general": "General constitutional \u2014 fever, fatigue, weight"
  },
